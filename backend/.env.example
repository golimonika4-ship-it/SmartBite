# ===================================================================
# SmartBite Environment Variables Template (backend/.env.example)
# Copy this file to .env and customize values for your local environment.
# NEVER commit the actual .env file or sensitive passwords to Git.
# ===================================================================

# Server Configuration
SERVER_PORT=8080

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smartbite
DB_USERNAME=smartbite_user
DB_PASSWORD=your_mysql_password_here

# JWT Security Configuration (HMAC-SHA256, minimum 32 characters / 256 bits)
JWT_SECRET=your_secure_random_jwt_secret_key_minimum_256_bits_here_12345!
JWT_EXPIRATION_MS=86400000

# Initial Admin Account Seed Configuration
SMARTBITE_ADMIN_NAME=Campus Canteen Administrator
SMARTBITE_ADMIN_EMAIL=admin@smartbite.campus
SMARTBITE_ADMIN_ROLL=ADMIN-01
SMARTBITE_ADMIN_PASSWORD=your_secure_initial_admin_password_here
